<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AIPawnControl</RootNamespace>
    <AssemblyName>AIPawnControl</AssemblyName>
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <Nullable>disable</Nullable>

    <!-- Override on the command line or in Directory.Build.props.user if your install differs -->
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">D:\SteamLibrary\steamapps\common\RimWorld</RimWorldDir>
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">D:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.6\Assemblies</HarmonyDir> <!-- Harmony has no 1.7 or Current folder; its 1.6 build runs on 1.7 -->
    <ManagedDir>$(RimWorldDir)</ManagedDir> <!-- 1.7 keeps its assemblies in the game folder itself -->  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Framework assemblies that ship with the game's Mono -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- Game + Harmony assemblies are provided at runtime; never copy them into the mod -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <!-- 1.7 has no Unity: UnityEngine's types (Rect, Vector2, Texture2D, GUI…) come from these two -->
    <Reference Include="UnityStubs"><HintPath>$(ManagedDir)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith.UnityCompat"><HintPath>$(ManagedDir)\Waylith.UnityCompat.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
