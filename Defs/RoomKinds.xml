<?xml version="1.0" encoding="utf-8"?>
<!--
  Room kinds a mind can build (PHASE4.md §1). A kind is the set of items that makes vanilla give a room its role; the
  project is done when vanilla really gives it. Item rules: backToWall (the default), centre, nextTo (index of an
  earlier item), inWall (in the wall facing out, a cooler), repeat/min, forEveryone (one per sleeper, at least repeat), perAnchor (with nextTo: this many per copy
  of the anchor, which repeats until all fit), optional, preferNew, medical, clearAround. need (bed, seat, shelf, accessory, cooler, heater, joy) picks the
  best buildable def by what it does instead of a defs list (FURNISHING.md §4), so research and mods reach it. minSize: x = the short side, z = the long side.
  stores: what its stockpile and shelves take (Root = vanilla's default stockpile), storePriority, holdTemperature (its
  coolers' setting). No kind carries a heater: a mind chooses to warm (or cool) a room once it's uncomfortable (the
  Base call's "warm the X" line, Upgrades.Temperature); the need is still there for a kind that wants one. size: the interior code builds it at (default 5x5; STREAMLINE.md §7). Order matters: it's the order the kinds are listed
  to the model.
-->
<Defs>
  <AIPawnControl.RoomKindDef>
    <defName>AIPC_Bedroom</defName>
    <label>bedroom</label>
    <description>a bed and something beside it</description>
    <role>Bedroom</role>
    <owned>true</owned>
    <size>(4,4)</size>
    <items>
      <li><need>bed</need><backToWall>true</backToWall></li>
      <li><need>accessory</need><nextTo>0</nextTo><optional>true</optional></li>
    </items>
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef>
    <defName>AIPC_Barracks</defName>
    <label>barracks</label>
    <description>beds for several colonists</description>
    <role>Barracks</role>
    <items>
      <li><need>bed</need><backToWall>true</backToWall><repeat>6</repeat><min>4</min></li> <!-- at least 4 (BASE_GROWTH.md §6.1) -->
    </items>
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef>
    <defName>AIPC_Kitchen</defName>
    <label>kitchen</label>
    <description>a fueled stove and a butcher table</description>
    <role>Kitchen</role>
    <items>
      <li><defs><li>FueledStove</li></defs><backToWall>true</backToWall></li>
      <li><defs><li>TableButcher</li><li>ButcherSpot</li></defs><backToWall>true</backToWall><optional>true</optional></li>
    </items>
  </AIPawnControl.RoomKindDef>

  <!-- BASE_GROWTH.md §11: one room where everyone eats and relaxes. No role: vanilla calls it a dining room or a rec room
       by whichever scores higher, and either is fine (the user's call), so it's done once built. -->
  <AIPawnControl.RoomKindDef>
    <defName>AIPC_GreatHall</defName>
    <label>great hall</label>
    <description>tables and seats for everyone, and games</description>
    <minSize>(4,6)</minSize> <!-- horseshoes are thrown from 5 cells away -->
    <size>(7,7)</size>
    <items> <!-- a seat for every sleeper, at least 4, 4 to a table (BASE_GROWTH.md §6.1) -->
      <li><defs><li>Table2x2c</li><li>Table1x2c</li></defs><centre>true</centre></li>
      <li><need>seat</need><nextTo>0</nextTo><repeat>4</repeat><forEveryone>true</forEveryone><perAnchor>4</perAnchor></li>
      <li><need>joy</need><backToWall>true</backToWall><repeat>2</repeat><optional>true</optional><clearAround>2</clearAround></li> <!-- each a different joy kind -->
    </items>
  </AIPawnControl.RoomKindDef>

  <!-- HYGIENE.md: with Dubs Bad Hygiene, a communal bathroom. Toilets and showers go in stalls (RoomPlacer.Stall: walls
       between them and a stall door in front); a water tub needs no stall. DBH calls it a public bathroom with 2 toilets.
       Plumbed fixtures only once the plumbing is built (Hygiene.Plumbed); otherwise latrines and a water tub. -->
  <AIPawnControl.RoomKindDef MayRequire="Dubwise.DubsBadHygiene">
    <defName>AIPC_Bathroom</defName>
    <label>bathroom</label>
    <description>toilet stalls and somewhere to wash</description>
    <role>PublicBathroom</role>
    <minSize>(3,5)</minSize>
    <size>(5,3)</size>
    <items>
      <li><defs><li>ToiletAdvStuff</li><li>ToiletStuff</li><li>PitLatrine</li></defs><repeat>2</repeat></li>
      <li><defs><li>ShowerAdvStuff</li><li>ShowerStuff</li><li>ShowerSimple</li><li>WashBucket</li></defs><optional>true</optional></li>
    </items>
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef>
    <defName>AIPC_Workshop</defName>
    <label>workshop</label>
    <description>a work table the colony doesn't have yet</description>
    <role>Workshop</role>
    <items>
      <li>
        <defs><li>TableStonecutter</li><li>HandTailoringBench</li><li>FueledSmithy</li><li>TableSculpting</li></defs>
        <backToWall>true</backToWall><preferNew>true</preferNew>
      </li>
    </items>
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef>
    <defName>AIPC_Laboratory</defName>
    <label>laboratory</label>
    <description>a simple research bench</description>
    <role>Laboratory</role>
    <size>(4,4)</size>
    <items>
      <li><defs><li>SimpleResearchBench</li></defs><backToWall>true</backToWall></li>
    </items>
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef>
    <defName>AIPC_Hospital</defName>
    <label>hospital</label>
    <description>medical beds</description>
    <role>Hospital</role>
    <items>
      <li><defs><li>HospitalBed</li><li>Bed</li></defs><backToWall>true</backToWall><repeat>3</repeat><medical>true</medical></li>
    </items>
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef>
    <defName>AIPC_Storeroom</defName>
    <label>storeroom</label>
    <description>shelves along the walls</description>
    <role>Storeroom</role>
    <items>
      <li><need>shelf</need><backToWall>true</backToWall><repeat>6</repeat></li>
    </items>
    <stores><li>Root</li></stores> <!-- vanilla's default "everything" stockpile on its free floor -->
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef>
    <defName>AIPC_PlainRoom</defName>
    <label>plain room</label>
    <description>empty, to furnish later</description>
  </AIPawnControl.RoomKindDef>

  <!-- BASE_GROWTH.md §6.6 group 3: other rooms, offered only when the colony has what they're for. -->
  <AIPawnControl.RoomKindDef>
    <defName>AIPC_Barn</defName>
    <label>barn</label>
    <description>beds for the colony's animals</description>
    <role>Barn</role>
    <offeredWhen>animals</offeredWhen>
    <items>
      <li><need>animalBed</need><backToWall>true</backToWall><repeat>4</repeat></li>
    </items>
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>AIPC_Classroom</defName>
    <label>classroom</label>
    <description>school desks and a blackboard</description>
    <role>Classroom</role>
    <offeredWhen>children</offeredWhen>
    <items>
      <li><defs><li>SchoolDesk</li></defs><backToWall>true</backToWall><repeat>2</repeat></li>
      <li><defs><li>Blackboard</li></defs><backToWall>true</backToWall><optional>true</optional></li>
    </items>
  </AIPawnControl.RoomKindDef>

  <!-- BASE_GROWTH.md §6.6: rooms the game asks for (AskedFor.cs). Offered only when vanilla's alert or state asks, first
       under "Other rooms"; their items come from vanilla's own requirement lists there, so none are listed here. -->
  <AIPawnControl.RoomKindDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>AIPC_ThroneRoom</defName>
    <label>throne room</label>
    <description>a throne and what the title asks for</description>
    <role>ThroneRoom</role>
    <askedFor>throne</askedFor>
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>AIPC_Temple</defName>
    <label>temple</label>
    <description>the building the ideoligion asks for, in a room of its own</description>
    <askedFor>ideoBuilding</askedFor>
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>AIPC_Nursery</defName>
    <label>nursery</label>
    <description>cribs for the babies</description>
    <role>Nursery</role>
    <askedFor>nursery</askedFor>
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>AIPC_DeathrestChamber</defName>
    <label>deathrest chamber</label>
    <description>a deathrest casket</description>
    <role>DeathrestChamber</role>
    <askedFor>deathrest</askedFor>
    <size>(4,4)</size>
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef>
    <defName>AIPC_PrisonCell</defName>
    <label>prison cell</label>
    <description>a bed for a prisoner</description>
    <role>PrisonCell</role>
    <askedFor>prison</askedFor>
    <size>(4,4)</size>
  </AIPawnControl.RoomKindDef>

  <!-- BASE_LAYOUT.md: made by the layout code, never offered as rooms of their own (layout). A hall is a hub
       (SiteFinder.Hubs) with no furniture: as narrow as the gap between rooms allows. -->
  <AIPawnControl.RoomKindDef>
    <defName>AIPC_Hall</defName>
    <label>hall</label>
    <description>a shared room other rooms open into</description>
    <minSize>(1,1)</minSize>
    <layout>true</layout>
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef>
    <defName>AIPC_Doorway</defName>
    <label>doorway</label>
    <description>a door between two rooms</description>
    <layout>true</layout>
  </AIPawnControl.RoomKindDef>

  <AIPawnControl.RoomKindDef>
    <defName>AIPC_ClosedDoor</defName>
    <label>closed doorway</label>
    <description>a wall where a way out was</description>
    <layout>true</layout>
  </AIPawnControl.RoomKindDef>
</Defs>
